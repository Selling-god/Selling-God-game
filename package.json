{
  "name": "starfall-online",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Starfall Online - server-authoritative pixel action RPG",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --env-file-if-exists=.env server/index.js",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "python tests/browser.py",
    "test:load": "node tests/load.mjs",
    "check:deploy": "node scripts/check-deploy.mjs"
  },
  "dependencies": {
    "ws": "8.18.3"
  }
}
