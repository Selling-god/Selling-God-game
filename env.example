# RIFT DECK v2.2 server-side environment example
PORT=3000

# Required for cloud login + persistence
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Recommended current Supabase key name (server only)
SUPABASE_SECRET_KEY=sb_secret_YOUR_SECRET_KEY
# Legacy projects may use this instead of SUPABASE_SECRET_KEY:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_JWT

# Optional. The server can operate without this because Auth requests are proxied server-side.
# Current key name:
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
# Legacy equivalent:
# SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_KEY
