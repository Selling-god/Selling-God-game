+function fusionPair(room,u){const pc=pcOf(room,u.profileId),a=pc?.units?.find(x=>x.hp>0&&!x.fused),b=pc?.bench?.find(x=>x.hp>0&&!x.fused)||pc?.units?.find(x=>x.hp>0&&!x.fused&&x.instanceId!==a?.instanceId);return {pc,a,b};}
